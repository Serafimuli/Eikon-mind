# Configure these in the protected HCP Terraform production workspace instead.
# The values below are deliberately invalid so a copied file cannot deploy.
cloudflare_account_id = "replace-with-production-account-id"
cloudflare_zone_id    = "replace-with-existing-production-zone-id"
hostname              = "app.example.com"
email_from_address    = "noreply@example.com"
operations_mailbox    = "operations@example.com"

# Obtain these from the controller/DPO and record the approval outside Git.
retention = {
  appointment_days           = 0
  cancelled_appointment_days = 0
  deidentified_record_days   = 0
  audit_event_days           = 0
}
