{
  "name": "eikon-mind-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types",
    "cf:config": "node scripts/render-wrangler-config.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply eikon-mind --local",
    "db:migrate:remote": "wrangler d1 migrations apply eikon-mind --remote",
    "db:seed": "tsx scripts/seed.ts",
    "bootstrap:first-admin": "node scripts/bootstrap-first-admin.mjs",
    "test": "pnpm run test:unit",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:e2e": "node scripts/prepare-e2e.mjs && playwright test",
    "security:audit": "pnpm audit --audit-level high"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.1",
    "@opennextjs/cloudflare": "1.20.2",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "oxfmt": "0.67.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "wrangler": "4.129.1"
  }
}
