{
  "name": "eikon-mind-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "oxfmt",
    "cf:types": "wrangler types",
    "cf:config": "node scripts/render-wrangler-config.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply eikon-mind --local",
    "db:migrate:remote": "wrangler d1 migrations apply eikon-mind --remote",
    "db:seed": "tsx scripts/seed.ts",
    "bootstrap:first-admin": "node scripts/bootstrap-first-admin.mjs",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "@opennextjs/cloudflare": "^1.17.0",
    "@better-auth/drizzle-adapter": "^1.5.0",
    "better-auth": "^1.5.0",
    "drizzle-orm": "^0.44.7",
    "next": "^16.1.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "wrangler": "^4.0.0"
  }
}
