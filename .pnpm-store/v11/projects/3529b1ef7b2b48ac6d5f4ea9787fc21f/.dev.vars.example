# Copy this to .dev.vars; never use live credentials here.
APP_ENV="local"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRETS="v1:replace-with-a-random-32-plus-character-local-key"
TURNSTILE_SECRET="replace-with-a-turnstile-test-or-dev-secret"
TURNSTILE_SITEKEY="replace-with-a-turnstile-test-or-dev-sitekey"
EMAIL_FROM_ADDRESS="noreply@local.invalid"
GOOGLE_CLIENT_ID="local-not-configured"
GOOGLE_CLIENT_SECRET="local-not-configured"
GOOGLE_REFRESH_TOKEN="local-not-configured"
GOOGLE_CALENDAR_ID="local-not-configured"
RETENTION_APPOINTMENT_DAYS="30"
RETENTION_CANCELLED_APPOINTMENT_DAYS="14"
RETENTION_DEIDENTIFIED_RECORD_DAYS="30"
RETENTION_AUDIT_EVENT_DAYS="14"
